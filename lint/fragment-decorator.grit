language js

// A fragment is never connected, so a decorator placed on it is tied to nothing (docs/md/components.md#fragments).
`<>$children</>` where {
  $children <: some JsxExpressionChild(expression = $decorator) where {
    $decorator <: `$d($args)`,
    $d <: r"\$\w+"
  },
  register_diagnostic(
    span = $decorator,
    message = "A decorator on a fragment is tied to nothing: a fragment never gets connected. Put it on a real element (docs/md/components.md#fragments).",
    severity = "error"
  )
}
