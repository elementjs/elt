language js

// Anything typed `o.Out<T>` (a component attribute, a decorator option, a function parameter) is named
// `out_<name>`, so the direction shows where it is passed (docs/md/elt-rules.md, Naming). In an interface, a type
// literal, a class or a parameter list.
or {
  TsPropertySignatureTypeMember(name = $name, type_annotation = $type),
  JsPropertyClassMember(name = $name, property_annotation = $type),
  JsFormalParameter(binding = $name, type_annotation = $type)
} where {
  $type <: contains or { `o.Out<$_>`, `Out<$_>` },
  $name <: not r"out_\w+",
  register_diagnostic(
    span = $name,
    message = "Anything typed o.Out<T> is named out_<name> (docs/md/elt-rules.md, Naming).",
    severity = "error"
  )
}
