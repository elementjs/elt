language js

// An attribute a component writes for its caller (typed `o.Out<T>`) is named `out_<name>`, so the direction
// shows at the call site (docs/md/elt-rules.md, Components). In an interface, a type literal or a class.
or {
  TsPropertySignatureTypeMember(name = $name, type_annotation = $type),
  JsPropertyClassMember(name = $name, property_annotation = $type)
} where {
  $type <: contains or { `o.Out<$_>`, `Out<$_>` },
  $name <: not r"out_\w+",
  register_diagnostic(
    span = $name,
    message = "An attribute typed o.Out<T> is named out_<name> (docs/md/elt-rules.md, Components).",
    severity = "error"
  )
}
