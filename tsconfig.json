{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "react",
    "jsxFactory": "E",
    "jsxFragmentFactory": "E.Fragment",


    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "noEmit": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "lib": ["ESNext", "dom"],
    "types": [],
    "skipLibCheck": true,
    // The package's own exports, for files outside its package scope: docs/ has its own
    // package.json, so `elt` doesn't resolve from docs/src/code-example.tsx (which the test harness
    // imports) by self-reference. Same mapping as docs/tsconfig.json.
    "paths": {
      "elt": ["./src/index.ts"],
      "elt/ui": ["./ui/index.tsx"],
      "elt/ui/*": ["./ui/*.tsx"],
      "elt/editor": ["./editor/index.tsx"],
      "elt/editor/*": ["./editor/*.tsx"],
      "elt/*": ["./src/*.ts"]
    }
  },
  "include": [
    "./tests/**/*.ts"
  ],
  "files": [
    "./src/index.ts",
    "./ui/index.tsx",
    "./editor/index.tsx",
  ]
}
