{
  "files": {
    "includes": [
      "src/**",
      "ui/**",
      "editor/**",
      "tests/**",
      "docs/src/**",
      "!docs/src/md",
      "!docs/src/routes.generated.ts",
      "!tests/fixtures/lint",
      "!!**/.claude"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 120
    }
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 120,
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "useButtonType": "off"
      },
      "correctness": {
        "noVoidElementsWithChildren": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["ui/**", "editor/**", "docs/src/**"],
      "plugins": ["./lint/no-add-observer.grit", "./lint/no-node-mutation.grit", "./lint/no-raw-dom-insertion.grit"]
    },
    {
      "includes": ["tests/**", "docs/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    }
  ]
}
