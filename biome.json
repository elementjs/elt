{
  "files": {
    "includes": [
      "src/**",
      "ui/**",
      "editor/**",
      "tests/**",
      "docs/src/**",
      "docs/build.ts",
      "!docs/src/md",
      "!docs/src/routes.generated.ts",
      "!tests/fixtures/lint",
      "!!**/.claude"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 120
    }
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 120,
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "useButtonType": "off"
      },
      "correctness": {
        "noVoidElementsWithChildren": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "plugins": ["./lint/out-prefix.grit"]
    },
    {
      "includes": ["ui/**", "editor/**", "docs/src/**"],
      "plugins": [
        "./lint/no-add-observer.grit",
        "./lint/no-node-mutation.grit",
        "./lint/no-raw-dom-insertion.grit",
        "./lint/icon-button-name.grit",
        "./lint/out-prefix.grit",
        "./lint/out-no-read.grit",
        "./lint/no-event-listener.grit",
        "./lint/attr-declare.grit",
        "./lint/await-activate.grit",
        "./lint/fragment-decorator.grit",
        "./lint/observable-prefix.grit",
        "./lint/css-top-level.grit",
        "./lint/css-class-prefix.grit",
        "./lint/css-one-rule.grit"
      ]
    },
    {
      "includes": ["editor/**", "docs/src/**"],
      "plugins": [
        "./lint/no-margin.grit",
        "./lint/theme-colors.grit",
        "./lint/motion-tokens.grit",
        "./lint/layout-css.grit"
      ]
    },
    {
      "includes": ["tests/**", "docs/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    }
  ]
}
