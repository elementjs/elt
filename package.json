{
  "name": "elt",
  "version": "4.0.0-rc.0",
  "repository": "https://github.com/elementjs/elt",
  "description": "A TypeScript library for building web applications without a virtual DOM: JSX returns real DOM nodes, kept up to date by observables.",
  "license": "MIT",
  "workspaces": ["docs"],
  "main": "./src/index.ts",
  "files": ["src/", "ui/", "!ui/AGENTS.md", "editor/", "!editor/AGENTS.md", "lint/", "docs/md/", "README.md", "LICENSE"],
  "sideEffects": ["./src/css.ts", "./src/mutative.ts", "./src/elt.ts", "./src/index.ts", "./ui/index.tsx", "./ui/theme.tsx", "./ui/*.css.tsx"],
  "exports": {
    ".": "./src/index.ts",
    "./mutative": "./src/mutative.ts",
    "./ui": "./ui/index.tsx",
    "./ui/date": "./ui/date.tsx",
    "./ui/dialog": "./ui/dialog.tsx",
    "./ui/icons": "./ui/icons.tsx",
    "./ui/interactive": "./ui/interactive.ts",
    "./ui/keymap": "./ui/keymap.tsx",
    "./ui/list-nav": "./ui/list-nav.tsx",
    "./ui/motion": "./ui/motion.tsx",
    "./ui/popup": "./ui/popup.tsx",
    "./ui/resizable": "./ui/resizable.tsx",
    "./ui/select": "./ui/select.tsx",
    "./ui/spinner": "./ui/spinner.tsx",
    "./ui/textarea": "./ui/textarea.tsx",
    "./ui/theme": "./ui/theme.tsx",
    "./ui/timepicker": "./ui/timepicker.tsx",
    "./editor": "./editor/index.tsx"
  },

  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@floating-ui/dom": "^1.7.6",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "mutative": "^1.3.0",
    "typescript": "^7.0.2",
    "wtsc": "^0.2.1"
  },
  "peerDependencies": {
    "mutative": "1.x",
    "@floating-ui/dom": "^1.7.6"
  },
  "peerDependenciesMeta": {
    "mutative": { "optional": true },
    "@floating-ui/dom": { "optional": true }
  }
}
